{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/index.ts",
    "tests/**/*.test.ts",
    "tests/setup.ts",
    "tests/mocks/**/*.ts"
  ],
  "project": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ],
  "ignore": [
    "tests/utils/test-helpers.ts"
  ],
  "ignoreDependencies": [
    "@modelcontextprotocol/sdk"
  ],
  "ignoreBinaries": [],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "binaries": "warn",
    "dependencies": "error",
    "devDependencies": "warn",
    "duplicates": "error",
    "enumMembers": "warn",
    "exports": "warn",
    "files": "error",
    "nsExports": "warn",
    "classMembers": "warn",
    "types": "warn",
    "nsTypes": "warn",
    "unlisted": "warn",
    "unresolved": "error"
  },
  "vitest": {
    "config": "vitest.config.ts"
  }
}
