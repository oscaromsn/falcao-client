{
  "name": "@falcao/api-client",
  "version": "1.0.0",
  "description": "TypeScript client for the Falcão Jurisprudence Search API",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./schemas": {
      "bun": "./src/schemas/index.ts",
      "import": "./src/schemas/index.ts",
      "types": "./src/schemas/index.ts"
    },
    "./services": {
      "bun": "./src/services/index.ts",
      "import": "./src/services/index.ts",
      "types": "./src/services/index.ts"
    },
    "./core": {
      "bun": "./src/core/index.ts",
      "import": "./src/core/index.ts",
      "types": "./src/core/index.ts"
    }
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit --pretty",
    "typecheck:watch": "tsc --noEmit --watch",
    "typecheck:strict": "tsc --noEmit --exactOptionalPropertyTypes --pretty",
    "check": "biome check --write .",
    "validate:quick": "bun typecheck && bun check",
    "validate:complete": "bun typecheck:strict && bun check && bun knip",
    "validate:with-tests": "bun typecheck && bun check && bun test",
    "clean": "rm -rf dist coverage .tsbuildinfo node_modules/.cache",
    "example": "bun run examples/basic-usage.ts",
    "example:search": "bun run examples/search.ts",
    "example:auth": "bun run examples/authenticated.ts",
    "bench": "bun run bench/index.ts",
    "build:types": "tsc --emitDeclarationOnly",
    "release": "bun run check && bun test:coverage && bunx changeset publish"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "axios": "^1.11.0",
    "crypto-js": "^4.2.0",
    "zod": "^4.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@types/bun": "^1.2.19",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.1.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "jsdom": "^26.1.0",
    "knip": "5.62.0",
    "msw": "^2.10.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "keywords": [
    "falcao",
    "jurisprudence",
    "legal",
    "api-client",
    "typescript",
    "bun",
    "zod",
    "judicial",
    "brazil"
  ],
  "author": {
    "name": "Oscar Neto",
    "email": "oscaromsn@gmail.com"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "package.json",
    "tsconfig.json"
  ],
  "sideEffects": false,
  "packageManager": "bun@1.1.20"
}
